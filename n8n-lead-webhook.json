              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b3e1a7c0-0005-4a1e-9a51-000000000005",
      "name": "Save to Leads sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        920,
        -80
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Leads"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {
          "cellFormat": "RAW"
        }
      },
      "notes": "Connect Google and paste the sheet URL. Tab 'Leads', row 1 headers: submittedAt, name, email, company, phone, industry, interests, message, source, page, referrer, utm, status. RAW keeps phone zeros and stops formulas.",
      "notesInFlow": true
    },
    {
      "id": "b3e1a7c0-0006-4a1e-9a51-000000000006",
      "name": "Email me the lead",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1140,
        -80
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "sendTo": "2psbuilds@gmail.com",
        "subject": "=New website lead: {{ $('Sheet row').item.json.name }}{{ $('Sheet row').item.json.company ? ' (' + $('Sheet row').item.json.company + ')' : '' }}",
        "emailType": "text",
        "message": "=New discovery call request from the website.\n\nName: {{ $('Sheet row').item.json.name }}\nEmail: {{ $('Sheet row').item.json.email }}\nCompany: {{ $('Sheet row').item.json.company }}\nPhone: {{ $('Sheet row').item.json.phone }}\nIndustry: {{ $('Sheet row').item.json.industry }}\nInterested in: {{ $('Sheet row').item.json.interests }}\n\nWhat's slowing them down:\n{{ $('Sheet row').item.json.message }}\n\nSubmitted: {{ $('Sheet row').item.json.submittedAt }}\nPage: {{ $('Sheet row').item.json.page }}\n\nThe site promises a reply within one business day. This lead appears in the Operations OS inbox on its next sync.",
        "options": {
          "replyTo": "={{ $('Sheet row').item.json.email }}",
          "appendAttribution": false
        }
      },
      "notes": "Connect Gmail. If this fails, the lead is still saved and the visitor still sees success.",
      "notesInFlow": true
    },
    {
      "id": "b3e1a7c0-0007-4a1e-9a51-000000000007",
      "name": "Thank the lead (optional)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1360,
        -80
      ],
      "onError": "continueRegularOutput",
      "disabled": true,
      "parameters": {
        "sendTo": "={{ $('Sheet row').item.json.email }}",
        "subject": "We've got your discovery call request",
        "emailType": "text",
        "message": "=Hi {{ $('Read & check request').item.json.firstName }},\n\nThanks for reaching out to BEMO-SOLUTIONS. We've received your request for a free 30-minute discovery call and will be in touch within one business day to find a time that suits you.\n\nIf anything is urgent, just reply to this email.\n\nKind regards,\nBEMO-SOLUTIONS",
        "options": {
          "appendAttribution": false
        }
      },
      "notes": "OFF by default. Turn on to send every lead an instant acknowledgement from your Gmail.",
      "notesInFlow": true
    },
    {
      "id": "b3e1a7c0-0008-4a1e-9a51-000000000008",
