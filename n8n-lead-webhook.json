      "name": "Read Leads sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        700,
        120
      ],
      "alwaysOutputData": true,
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Leads"
        },
        "options": {}
      },
      "notes": "Same Google account and sheet as 'Save to Leads sheet'.",
      "notesInFlow": true
    },
    {
      "id": "b3e1a7c0-0010-4a1e-9a51-000000000010",
      "name": "Build lead list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Turn the sheet rows into the list the Operations OS expects. Newest 500 only.\nconst leads = $input.all()\n  .map(i => i.json)\n  .filter(r => r && (r.email || r.name))\n  .map(r => { const o = { ...r }; delete o.row_number; return o; });\nreturn [{ json: { ok: true, count: leads.length, leads: leads.slice(-500) } }];"
      }
    },
    {
      "id": "b3e1a7c0-0011-4a1e-9a51-000000000011",
      "name": "Reply: leads",
      "type": "n8n-nodes-base.respondToWebhook",
