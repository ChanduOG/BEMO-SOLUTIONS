{
  "name": "BEMO: Website leads + Operations OS sync",
  "nodes": [
    {
      "id": "b3e1a7c0-0001-4a1e-9a51-000000000001",
      "name": "Website & CRM requests",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "bemo-lead",
      "parameters": {
        "httpMethod": "POST",
        "path": "bemo-lead",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*",
          "rawBody": true
        }
      },
      "notes": "One URL for both: the website form posts leads here, and the Operations OS posts {action:'list', key} here to sync. Copy the PRODUCTION URL into the form's data-endpoint AND the CRM's Website connection. Keep Allowed Origins as * : the CRM runs from a local file. The lead list is protected by the CRM key instead.",
      "notesInFlow": true
    },
    {
      "id": "b3e1a7c0-0002-4a1e-9a51-000000000002",
      "name": "Read & check request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ── Set this once ─────────────────────────────────────────────────────────────\n// A long random secret (20+ characters). Paste the SAME value into the Operations OS:\n// Intake Inbox › plug icon (Website connection) › CRM key.\n// Until you change it, the CRM can't read leads (the website form still works).\nconst CRM_KEY = 'PASTE-A-LONG-RANDOM-KEY-HERE';\n// ──────────────────────────────────────────────────────────────────────────────\n\n// The website and CRM send JSON as text/plain (avoids a CORS preflight), so the\n// body can arrive parsed, as a string, or as raw binary. Handle all three.\nconst item = $input.first();\nlet b = item.json.body;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nif ((!b || typeof b !== 'object' || !Object.keys(b).length) && item.binary && item.binary.data) {\n  try { b = JSON.parse((await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8')); } catch (e) { b = {}; }\n}\nb = b && typeof b === 'object' ? b : {};\n\nconst clean = (v, max) => String(v ?? '').replace(/\\u0000/g, '').trim().slice(0, max);\n\n// The CRM asking for the lead list\nif (b.action === 'list') {\n  const ok = CRM_KEY.length >= 20 && !CRM_KEY.startsWith('PASTE') && String(b.key || '') === CRM_KEY;\n  return [{ json: { route: ok ? 'list' : 'denied' } }];\n}\n\n// The website form\nif (b.website) return [{ json: { route: 'bot' } }];               // honeypot filled\nconst name = clean(b.name, 120), email = clean(b.email, 160);\nif (!name || !/^\\S+@\\S+\\.\\S+$/.test(email)) return [{ json: { route: 'invalid' } }];\n\nconst d = new Date(b.submittedAt || Date.now());\nconst interests = (Array.isArray(b.interests) ? b.interests : String(b.interests || '').split(','))\n  .map(s => clean(s, 40)).filter(Boolean);\nreturn [{ json: {\n  route: 'lead',\n  submittedAt: isNaN(d) ? new Date().toISOString() : d.toISOString(),\n  name, email,\n  company: clean(b.company, 160),\n  phone: clean(b.phone, 40),\n  industry: clean(b.industry, 60),\n  interests: interests.join(', '),\n  message: clean(b.message, 4000),\n  source: clean(b.source, 80),\n  page: clean(b.page, 500),\n  referrer: clean(b.referrer, 500),\n  utm: JSON.stringify(b.utm && typeof b.utm === 'object' ? b.utm : {}).slice(0, 500),\n  status: 'New',\n  firstName: name.split(' ')[0]\n} }];"
      },
      "notes": "Set CRM_KEY at the top of the code.",
      "notesInFlow": true
    },
    {
      "id": "b3e1a7c0-0003-4a1e-9a51-000000000003",
      "name": "Route",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r-lead",
                    "leftValue": "={{ $json.route }}",
                    "rightValue": "lead",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "New lead"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r-list",
                    "leftValue": "={{ $json.route }}",
                    "rightValue": "list",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "CRM sync"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r-denied",
                    "leftValue": "={{ $json.route }}",
                    "rightValue": "denied",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Wrong key"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r-invalid",
                    "leftValue": "={{ $json.route }}",
                    "rightValue": "invalid",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Invalid"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r-bot",
                    "leftValue": "={{ $json.route }}",
                    "rightValue": "bot",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Bot"
            }
          ]
        },
        "options": {}
      }
    },
    {
